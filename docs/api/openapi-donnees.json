{
  "openapi": "3.1.0",
  "info": {
    "title": "K-B data API",
    "description": "Thank you to arXiv for use of its open access interoperability.",
    "version": "0.5.0"
  },
  "paths": {
    "/items": {
      "get": {
        "tags": [
          "items"
        ],
        "summary": "List Items",
        "description": "A page of the items, the newest first by the date the source gives.",
        "operationId": "list_items_items_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "paper",
                      "vulnerability",
                      "newsletter_article",
                      "release",
                      "advisory",
                      "zotero_entry",
                      "clip"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPageSchema"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "422": {
            "description": "invalid_parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidParameterSchema"
                }
              }
            }
          },
          "500": {
            "description": "database_error, internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "503": {
            "description": "database_missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        }
      }
    },
    "/items/{item_id}": {
      "get": {
        "tags": [
          "items"
        ],
        "summary": "Read Item",
        "description": "An item, with what its kind serves beyond the list.",
        "operationId": "read_item_items__item_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PaperDetailSchema"
                    },
                    {
                      "$ref": "#/components/schemas/VulnerabilityDetailSchema"
                    },
                    {
                      "$ref": "#/components/schemas/ReleaseDetailSchema"
                    },
                    {
                      "$ref": "#/components/schemas/AdvisoryDetailSchema"
                    },
                    {
                      "$ref": "#/components/schemas/NewsletterArticleDetailSchema"
                    },
                    {
                      "$ref": "#/components/schemas/ZoteroEntryDetailSchema"
                    },
                    {
                      "$ref": "#/components/schemas/ClipDetailSchema"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "paper": "#/components/schemas/PaperDetailSchema",
                      "vulnerability": "#/components/schemas/VulnerabilityDetailSchema",
                      "release": "#/components/schemas/ReleaseDetailSchema",
                      "advisory": "#/components/schemas/AdvisoryDetailSchema",
                      "newsletter_article": "#/components/schemas/NewsletterArticleDetailSchema",
                      "zotero_entry": "#/components/schemas/ZoteroEntryDetailSchema",
                      "clip": "#/components/schemas/ClipDetailSchema"
                    }
                  },
                  "title": "Response Read Item Items  Item Id  Get"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "422": {
            "description": "invalid_parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidParameterSchema"
                }
              }
            }
          },
          "500": {
            "description": "database_error, internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "503": {
            "description": "database_missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "404": {
            "description": "item_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        }
      }
    },
    "/trends": {
      "get": {
        "tags": [
          "trends"
        ],
        "summary": "List Trends",
        "description": "The trends of a window, the latest in the base when none is given.",
        "operationId": "list_trends_trends_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "window_end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Window End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendWindowSchema"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "422": {
            "description": "invalid_parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidParameterSchema"
                }
              }
            }
          },
          "500": {
            "description": "database_error, internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "503": {
            "description": "database_missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "404": {
            "description": "trend_window_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        }
      }
    }
  },
