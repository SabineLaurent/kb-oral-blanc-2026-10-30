# Copy to .env.e2e_test (ignored by git) and fill in. Never commit real values.
# The variables of the end-to-end tests alone (tests/e2e/), given to them by
#   uv run --env-file .env.e2e_test pytest -m e2e -rs
# from a terminal without .env exported: any other variable of .env.example, or any
# KB_DATA_API_KEY_<CLIENT>, in the environment stops the tests before any kb, but the ones the test sets itself (KB_DATA_DIR, KB_COLLECT_ONLY)
# or tests/conftest.py removes (KB_LOG_TO_FILE, KB_DATA_API_HOST, KB_DATA_API_PORT,
# KB_DATA_API_ALLOWED_HOSTS).

# Optional: fine-grained GitHub token, public repositories only, no permission (docs/jeton-github.md).
# Without it, the GitHub sources run on 60 requests per hour instead of 5,000.
KB_GITHUB_TOKEN=

# Optional: the Zotero data directory, read through a temporary copy. Full path, no ~. Without it,
# the test of zotero is skipped.
KB_ZOTERO_DIR=

# Optional: the Obsidian vault of K-B, the folder that holds Clippings/. Full path, no ~. Without
# it, the test of clipping is skipped.
KB_VAULT_DIR=

# Optional: BigQuery service account key, for GH Archive (docs/bigquery.md). Without it, the test
# of gh_archive is skipped; with it, the test runs a real BigQuery query.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: the export of the measures of the AI API, as in .env.example (sandbox for the tests).
# Without the endpoint and the headers, the test of the export is skipped; with them, it sends the
# measures of one request on the replay to the OTLP endpoint.
KB_OTLP_ENDPOINT=
KB_OTLP_HEADERS=
KB_DEPLOYMENT_ENVIRONMENT=sandbox
