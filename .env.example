# Copy to .env (ignored by git) and fill in. Never commit real values.

# Required by `kb collect`: the data directory, outside the code repository; raw/ and
# collection_state.json are written in it.
KB_DATA_DIR=/path/to/your/k-b-data

# Optional: fine-grained GitHub token, public repositories only, no permission (docs/jeton-github.md).
# Without it, the GitHub API allows 60 requests per hour instead of 5,000.
KB_GITHUB_TOKEN=github_pat_YourFineGrainedTokenHere

# Optional: BigQuery service account key, for GH Archive (docs/bigquery.md). Without it, gh_archive
# is skipped.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/bigquery-key.json

# Optional: the Zotero data directory, read through a temporary copy (docs/specs-collecte.md). Full path, no ~.
KB_ZOTERO_DIR=/path/to/your/zotero-data

# Optional: the Obsidian vault of K-B, the folder that holds Clippings/ (docs/specs-collecte.md).
# Full path, no ~. Without it, kb collect skips the clips; with it, each clip new or changed is
# copied as it is under raw/selected_library/clipping/; K-B never changes a clip. Required by
# kb write-tops, which writes the sheets of the tops under veille/tops/ of the vault, and by
# kb digest, which writes the digests under veille/<subject>/.
KB_VAULT_DIR=/path/to/your/obsidian-vault

# Optional, kb collect: the source folders to run, separated by commas, for example zotero,clipping
# (docs/specs-collecte.md, "Choisir les sources"). Not set: every source. A name that is not a
# source folder, or a source chosen without its variable (zotero without KB_ZOTERO_DIR), exits 2
# without collecting anything.
# KB_COLLECT_ONLY=

# Required by `kb serve-data`: one key per client of the data API, KB_DATA_API_KEY_<CLIENT>, CLIENT of
# A-Z, 0-9 and _ (docs/specs-api.md). Make each key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty here: kb serve-data refuses a key of fewer than 32 characters.
KB_DATA_API_KEY_TERMINAL=

# Optional, kb serve-data: the host it listens on (an IPv4 address; 0.0.0.0 in a container) and its
# port. Not set: 127.0.0.1 and 8000 (core/config.py).
# KB_DATA_API_HOST=127.0.0.1
# KB_DATA_API_PORT=8000
# Optional, kb serve-data: the hosts the API answers, separated by commas, each a lowercase name without
# * nor port (docs/specs-api.md). Not set: 127.0.0.1 and localhost. In a container, set
# KB_DATA_API_ALLOWED_HOSTS to the service name too.
# KB_DATA_API_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional, every command: false logs on stderr only, without the log file of the data directory.
# Not set: true.
# KB_LOG_TO_FILE=true

# Required by `kb serve-ai`: one key per client of the AI API, KB_AI_API_KEY_<CLIENT>, by the
# rules of KB_DATA_API_KEY_<CLIENT> above; kb digest is the client KB_DIGEST, and reads the same
# variable to send its key. Left empty here: kb serve-ai and kb digest refuse a key of fewer than
# 32 characters.
KB_AI_API_KEY_KB_DIGEST=
# Optional, kb digest: the URL of the AI API, http or https, without user, query nor fragment.
# Not set: http://127.0.0.1:8001 (core/config.py); it does not follow KB_AI_API_PORT: set it too
# when the port changes.
# KB_AI_API_URL=http://127.0.0.1:8001

# Optional, kb serve-ai: the host it listens on (an IPv4 address; 0.0.0.0 in a container), its
# port, and the window of a request that gives none, in days, from 1 to 14. Not set: 127.0.0.1,
# 8001 and 3 (core/config.py).
# KB_AI_API_HOST=127.0.0.1
# KB_AI_API_PORT=8001
# KB_DIGEST_WINDOW_DAYS=3

# Required by the AI API: the model, called by an OpenAI-compatible API (docs/fiches-veille.md).
# openai_compatible for a real provider, replay for the answers of a file, without network nor key.
# No default: without it, the AI API does not start.
KB_LLM_PROVIDER=
# openai_compatible only: the base URL, https, without user, query nor fragment (Azure AI Foundry:
# https://<resource>.openai.azure.com/openai/v1), the deployment name, and the key, sent as
# Authorization: Bearer.
KB_LLM_BASE_URL=
KB_LLM_MODEL=
KB_LLM_API_KEY=
# none sends reasoning_effort "none" instead of temperature 0. Required for gpt-6-luna, which
# refuses temperature 0 alone: without it, each call gets a 400 unsupported_value, read
# llm_unavailable (docs/fiches-veille.md, "Réglages d'appel"). Not set: temperature 0, for a model
# that takes it.
KB_LLM_REASONING_EFFORT=none
# replay only: the JSON file of the answers, given in order (src/k_b/ai_api/connectors/llm_replay.py).
# KB_LLM_REPLAY_FILE=/path/to/replay.json

# Required by the AI API: the key it sends to the data API. It is the variable kb serve-data reads for
# its client AI_DIGEST (see KB_DATA_API_KEY_TERMINAL above): once set, kb serve-data serves this
# client too. Left commented here, since kb serve-data refuses an empty key.
# KB_DATA_API_KEY_AI_DIGEST=
# Optional, AI API: the URL of the data API, http or https, without user, query nor fragment.
# Not set: http://127.0.0.1:8000 (core/config.py); it does not follow KB_DATA_API_PORT: set it
# too when the port changes. In a container, the service name (http://api-donnees:8000), which
# KB_DATA_API_ALLOWED_HOSTS must hold too, or the data API answers 400 (data_api_invalid_response).
# KB_DATA_API_URL=http://127.0.0.1:8000

# Optional, kb serve-ai: the export of the measures of the model and of the traces of each request
# in OpenTelemetry, by OTLP over HTTP (docs/fiches-veille.md, "Métriques", "Traces de POST
# /digests"). Both or neither; without them, nothing is exported.
# The endpoint: the base URL of the OTLP gateway, https, without user, query nor fragment; K-B adds
# /v1/metrics, /v1/traces and /v1/logs (Grafana Cloud:
# https://otlp-gateway-<region>.grafana.net/otlp, a region of the EU).
# The headers: name=value pairs separated by commas, each value percent-encoded, as Grafana Cloud
# gives them: Authorization=Basic%20 followed by the base64 of instance-id:token, with no angle
# brackets nor space (Authorization=Basic%20MTIzNDU2OmdsY18uLi4=). The token: an access policy
# token with the scopes metrics:write, traces:write and logs:write only, on this stack only. Never
# logged nor quoted.
# KB_OTLP_ENDPOINT=
# KB_OTLP_HEADERS=
# Required with the export: sandbox or production, the environment the measures carry. No default:
# a production labelled sandbox would say nothing.
# KB_DEPLOYMENT_ENVIRONMENT=
# Optional, with the export: the content of each request to the model (prompt, items sent, output)
# sent with the traces, as a log record tied to its span (.claude/rules/poc.md, rule 5, exception;
# docs/registre-traitements.md: personal data, the DPA of the tool must be signed first). none: never;
# anomalies: the calls in anomaly only; all: every call, refused in production. Set without the
# export, kb serve-ai refuses to start. Not set: none.
# KB_TRACE_CONTENT=none
# No OTEL_* variable: kb serve-ai refuses to start with one, the OpenTelemetry SDK would read it
# behind the back of K-B.
